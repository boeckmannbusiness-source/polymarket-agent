# =============================================================================
# Polymarket Intelligence Agent - Environment Configuration
# =============================================================================

# --- Polymarket APIs ---
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_ETH_PRIVATE_KEY=

# --- Polygon Blockchain ---
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_WS_URL=wss://polygon-rpc.com/ws
POLYGON_CHAIN_ID=137

# --- Smart Contracts ---
CTF_EXCHANGE_ADDRESS=0xE111180000d2663C0091e4f400237545B87B996B
NEG_RISK_CTF_EXCHANGE_ADDRESS=0xe2222d279d744050d28e00520010520000310F59
CONDITIONAL_TOKENS_ADDRESS=0x4D97DCd97eC945f40cF65F87097ACe5EA0476045
PUSD_TOKEN_ADDRESS=0xC011a7E12a19f7B1f670d46F03B03f3342E82DFB

# --- LLM Providers ---
LLM_DEFAULT_PROVIDER=fallback

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_DEFAULT_MODEL=llama3

MISTRAL_API_KEY=
MISTRAL_DEFAULT_MODEL=mistral-small-latest

ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/v1
ZAI_DEFAULT_MODEL=glm-4.7-flash

GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# --- PostgreSQL (Neon Cloud) ---
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/polymarket
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# --- Redis (Redis Cloud) ---
REDIS_URL=redis://user:password@host:6379/0
REDIS_MAX_CONNECTIONS=50

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_LEVEL=info

# --- Trading ---
TRADING_MODE=paper
PAPER_INITIAL_CAPITAL=10000
MAX_POSITION_SIZE_PERCENT=10
MAX_DAILY_LOSS=500
MAX_OPEN_POSITIONS=5
EXPOSURE_LIMIT=0.3
COOLDOWN_MINUTES=15
MIN_CONFIDENCE_THRESHOLD=0.6
STOP_LOSS_PERCENT=15
TAKE_PROFIT_PERCENT=50

# --- Monitoring ---
LOG_LEVEL=INFO
LOG_FORMAT=text
METRICS_ENABLED=true
HEARTBEAT_INTERVAL_SECONDS=30

# --- App ---
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://polymarket-agent-tau.vercel.app
