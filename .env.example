# ── App ──
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ── Polymarket APIs ──
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_ETH_PRIVATE_KEY=

# ── Polygon ──
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_WS_URL=wss://polygon-rpc.com/ws
POLYGON_CHAIN_ID=137

# ── Smart Contracts ──
CTF_EXCHANGE_ADDRESS=0xE111180000d2663C0091e4f400237545B87B996B
NEG_RISK_CTF_EXCHANGE_ADDRESS=0xe2222d279d744050d28e00520010520000310F59
CONDITIONAL_TOKENS_ADDRESS=0x4D97DCd97eC945f40cF65F87097ACe5EA0476045
PUSD_TOKEN_ADDRESS=0xC011a7E12a19f7B1f670d46F03B03f3342E82DFB

# ── LLM Providers ──
LLM_DEFAULT_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_DEFAULT_MODEL=llama3
MISTRAL_API_KEY=
MISTRAL_DEFAULT_MODEL=mistral-small-latest
ZAI_API_KEY=
ZAI_BASE_URL=
ZAI_DEFAULT_MODEL=z-ai-model
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

# ── Database ──
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/polymarket
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=1

# ── Redis ──
REDIS_URL=redis://user:password@host:6379/0
REDIS_MAX_CONNECTIONS=10
REDIS_STREAM_MAXLEN=1000

# ── Telegram ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_LEVEL=info

# ── Trading ──
TRADING_MODE=paper
PAPER_INITIAL_CAPITAL=10000.0
MAX_POSITION_SIZE_PERCENT=10.0
MAX_DAILY_LOSS=500.0
MAX_OPEN_POSITIONS=5
EXPOSURE_LIMIT=0.3
COOLDOWN_MINUTES=15
MIN_CONFIDENCE_THRESHOLD=0.6

# ── Monitoring ──
LOG_LEVEL=WARNING
LOG_FORMAT=json
ADMIN_API_KEY=
METRICS_ENABLED=true
HEARTBEAT_INTERVAL_SECONDS=30

# ── Kill Switch ──
FORCE_TRADING_DISABLED=false
CLOSE_ALL_POSITIONS_ON_KILL=false

# ── Micro-live Safety ──
MICRO_LIVE_SAFE_MODE=false
MICRO_LIVE_MAX_POSITION_SIZE=1.0
MICRO_LIVE_MAX_DAILY_LOSS=2.0
MICRO_LIVE_MAX_CONCURRENT=2

# ── WS Stability ──
WS_STALL_SECONDS=60
WS_RECONNECT_STORM_THRESHOLD=5
WS_RECONNECT_WINDOW_MINUTES=10

# ── Runtime Health ──
MEMORY_WARN_MB=500
EVENT_LOOP_STALL_SECONDS=2.0
TASK_WATCHDOG_INTERVAL=60
